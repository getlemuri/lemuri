<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs + FindSecBugs findings checked by hand and left as they are, each with the reason.
  Anything not listed here fails ./mvnw spotbugs:check. Keep the matches as narrow as the reason.
-->
<FindBugsFilter>
  <!-- Plain data read and written by Gson: public fields are the format. -->
  <Match>
    <Class name="~lemuri\.be\.dto\.(Host|Parcel)" />
    <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE,UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR" />
  </Match>

  <!-- Public final JavaFX properties and observable lists: the views bind to them. -->
  <Match>
    <Class name="~lemuri\.fe\.(m\.(AppState|Task)|v\.ActivityLog)" />
    <Bug pattern="PA_PUBLIC_MUTABLE_OBJECT_ATTRIBUTE" />
  </Match>

  <!-- A pane's two halves exist exactly when the pane is divided (see Pane.divided()). -->
  <Match>
    <Class name="lemuri.fe.m.Pane" />
    <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR" />
  </Match>

  <!-- The log formatter (be/util/Log) writes \r and \n as \\r and \\n: no forged lines. Global on purpose:
       the formatter handles every message, whatever class it comes from. -->
  <Match>
    <Bug pattern="CRLF_INJECTION_LOGS" />
  </Match>

  <!-- Stack traces go only to the user's own log file, which never holds secrets. -->
  <Match>
    <Class name="~lemuri\.be\.util\.Log.*" />
    <Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE" />
  </Match>

  <!-- D-Bus method and field names are fixed by the StatusNotifierItem and com.canonical.dbusmenu protocols. -->
  <Match>
    <Class name="~lemuri\.fe\.v\.AppIndicator.*" />
    <Bug pattern="NM_METHOD_NAMING_CONVENTION,URF_UNREAD_PUBLIC_OR_PROTECTED_FIELD" />
  </Match>

  <!-- Lan.send rethrows, after trying every address, the first error it met: an unchecked one stays unchecked. -->
  <Match>
    <Class name="lemuri.be.sharing.Lan" />
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
  </Match>

  <!-- Unicode case mapping and normalization. ContactNames normalizes on purpose: it is the check that two
       contacts cannot look alike. The others compare names the user typed or chose (hosts, folders, jump hosts,
       ssh_config keywords) to find duplicates: no security decision. SharingDialogs also finds the twin of a
       received host, with an exact lower-case comparison of the address (not equalsIgnoreCase). -->
  <Match>
    <Bug pattern="IMPROPER_UNICODE" />
    <Or>
      <Class name="~lemuri\.be\.util\.ContactNames(\$.*)?" />
      <Class name="~lemuri\.be\.terminal\.Jumps(\$.*)?" />
      <Class name="~lemuri\.be\.util\.SshConfig(\$.*)?" />
      <Class name="~lemuri\.fe\.c\.HostController(\$.*)?" />
      <Class name="~lemuri\.fe\.m\.AppState(\$.*)?" />
      <Class name="~lemuri\.fe\.v\.Actions(\$.*)?" />
      <Class name="~lemuri\.fe\.v\.SharingDialogs(\$.*)?" />
      <Class name="~lemuri\.fe\.v\.SshImportDialog(\$.*)?" />
    </Or>
  </Match>

  <!-- Controllers, services, JavaFX nodes and models are shared on purpose: copying them would break the bindings. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP,EI_EXPOSE_STATIC_REP2" />
    <Or>
      <Class name="~lemuri\.be\.dto\.Resources(\$.*)?" />
      <Class name="~lemuri\.be\.monitoring\.Metrics(\$.*)?" />
      <Class name="~lemuri\.be\.service\.HostRepository(\$.*)?" />
      <Class name="~lemuri\.be\.sharing\.Sharing(\$.*)?" />
      <Class name="~lemuri\.fe\.c\.HostController(\$.*)?" />
      <Class name="~lemuri\.fe\.c\.LanController(\$.*)?" />
      <Class name="~lemuri\.fe\.c\.MonitorController(\$.*)?" />
      <Class name="~lemuri\.fe\.c\.SharingController(\$.*)?" />
      <Class name="~lemuri\.fe\.m\.Pane(\$.*)?" />
      <Class name="~lemuri\.fe\.m\.Session(\$.*)?" />
      <Class name="~lemuri\.fe\.v\.AppIcon(\$.*)?" />
      <Class name="~lemuri\.fe\.v\.Ui(\$.*)?" />
      <Class name="~lemuri\.fe\.v\.terminal\.Terminal(\$.*)?" />
    </Or>
  </Match>

  <!--
    Plain sockets: the local network carries only envelopes that are encrypted and signed (docs/crypto.md),
    and receipts; the single-instance port listens on 127.0.0.1 and needs a secret code; the probe only
    exchanges the public SSH version line.
  -->
  <Match>
    <Class name="~lemuri\.be\.(sharing\.Lan.*|util\.SingleInstance|monitoring\.Probe)" />
    <Bug pattern="UNENCRYPTED_SOCKET,UNENCRYPTED_SERVER_SOCKET" />
  </Match>

  <!-- JSch's UserInfo and the X11 replies use null for "cancelled" or "not there". -->
  <Match>
    <Bug pattern="PZLA_PREFER_ZERO_LENGTH_ARRAYS" />
    <Or>
      <Class name="~lemuri\.be\.monitoring\.Metrics(\$.*)?" />
      <Class name="~lemuri\.be\.terminal\.SshTransport(\$.*)?" />
      <Class name="lemuri.be.util.X11" />
    </Or>
  </Match>

  <!-- Casts dictated by JSch (ChannelSftp.ls) and JavaFX (Window, TreeItem) APIs. -->
  <Match>
    <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE" />
    <Or>
      <Class name="~lemuri\.fe\.v\.GhostMode(\$.*)?" />
      <Class name="~lemuri\.fe\.v\.sections\.FileBrowser(\$.*)?" />
    </Or>
  </Match>

  <!-- Names of vault entries ("sharing:private-key"…), not passwords. -->
  <Match>
    <Class name="~lemuri\.be\.sharing\.(Sharing|DecidedEnvelopes)" />
    <Bug pattern="HARD_CODE_PASSWORD" />
  </Match>

  <!-- The splash animation: random looks, no security. SingleInstance's code comes from SecureRandom. -->
  <Match>
    <Class name="~lemuri\.(fe\.v\.Splash|be\.util\.SingleInstance)" />
    <Bug pattern="PREDICTABLE_RANDOM,DMI_RANDOM_USED_ONLY_ONCE" />
  </Match>

  <!-- Window-wide state touched only from the JavaFX thread: the theme for dialogs, the main window, lazily built icons and timers. -->
  <Match>
    <Class name="~lemuri\.fe\.v\.(Console|Dialogs|AppIcon|GhostMode|Transfers)" />
    <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD,MS_CANNOT_BE_FINAL,LI_LAZY_INIT_STATIC,LI_LAZY_INIT_UPDATE_STATIC" />
  </Match>

  <!-- The canvas is resized only when the size really changed: an exact comparison is what is meant. -->
  <Match>
    <Class name="~lemuri\.fe\.v\.AppIcon.*" />
    <Bug pattern="FE_FLOATING_POINT_EQUALITY" />
  </Match>
</FindBugsFilter>
