# The app built and tested on Ubuntu 24.04 with its own Java 21 (src/test/distros/app.sh).
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jdk-headless openssh-client procps bash unzip ca-certificates fontconfig fonts-dejavu-core libgtk-3-0t64 libxslt1.1 && rm -rf /var/lib/apt/lists/*
