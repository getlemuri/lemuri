<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>lemuri</groupId>
  <artifactId>lemuri-desktop</artifactId>
  <version>0.1.0</version>
  <name>Lemuri</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.13</javafx.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <!-- WebView: hosts xterm.js, the same emulator as the web version. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-web</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.mwiede</groupId>
      <artifactId>jsch</artifactId>
      <version>2.28.8</version>
    </dependency>
    <!-- Pseudo-terminal for the local shell in the bottom panel. -->
    <dependency>
      <groupId>org.jetbrains.pty4j</groupId>
      <artifactId>pty4j</artifactId>
      <version>0.14.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.15.0</version>
    </dependency>
    <!-- Argon2id for the vault key: the JDK has only PBKDF2. Pure Java. -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.86</version>
    </dependency>
    <!-- D-Bus for the top-right icon on Linux (AppIndicator / StatusNotifierItem). -->
    <dependency>
      <groupId>com.github.hypfvieh</groupId>
      <artifactId>dbus-java-core</artifactId>
      <version>5.2.2</version>
    </dependency>
    <dependency>
      <groupId>com.github.hypfvieh</groupId>
      <artifactId>dbus-java-transport-native-unixsocket</artifactId>
      <version>5.2.2</version>
    </dependency>
    <!-- Library logs (SLF4J, from dbus-java) go to java.util.logging, in the same file as the app. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
      <version>2.0.20</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
    <!-- The interface driven by tests (clicks, menus, dialogs) without a screen: TestFX on Monocle's headless
         platform. Tests only. -->
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>openjfx-monocle</artifactId>
      <version>21.0.2</version>
      <scope>test</scope>
    </dependency>
    <!-- Real SSH and SFTP servers in memory, to test jump hosts and file names. Tests only. -->
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-core</artifactId>
      <version>2.20.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.sshd</groupId>
      <artifactId>sshd-sftp</artifactId>
      <version>2.20.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- Only version.properties gets ${project.version}: the other resources are copied as they are. -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>lemuri/version.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>lemuri/version.properties</exclude>
        </excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>requisiti</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <!-- The same texts on every machine, whatever its language: the interface tests look for them.
               On the command line of the JVM, because the default locale is fixed when it starts. -->
          <argLine>-Duser.language=en -Duser.country=US</argLine>
          <!-- The vault tests write into a fake home: never into ~/.lemuri. -->
          <systemPropertyVariables>
            <user.home>${project.build.directory}/test-home</user.home>
            <java.util.prefs.userRoot>${project.build.directory}/test-home/prefs</java.util.prefs.userRoot>
            <!-- The interface tests run without a screen (no window opens on the desktop, and CI has none). -->
            <testfx.robot>glass</testfx.robot>
            <testfx.headless>true</testfx.headless>
            <glass.platform>Monocle</glass.platform>
            <monocle.platform>Headless</monocle.platform>
            <headless.geometry>1920x1200-32</headless.geometry>
            <prism.order>sw</prism.order>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
          <!-- Nor the real display through X11 (the work areas of the monitors, the windows): the same on every machine. -->
          <excludedEnvironmentVariables>
            <param>DISPLAY</param>
          </excludedEnvironmentVariables>
        </configuration>
      </plugin>
      <!-- Static analysis with the security rules of FindSecBugs: ./mvnw spotbugs:check. The findings
           checked by hand and judged harmless are listed, each with the reason, in spotbugs-exclude.xml. -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.10.5.0</version>
        <configuration>
          <effort>Max</effort>
          <threshold>Low</threshold>
          <excludeFilterFile>spotbugs-exclude.xml</excludeFilterFile>
          <plugins>
            <plugin>
              <groupId>com.h3xstream.findsecbugs</groupId>
              <artifactId>findsecbugs-plugin</artifactId>
              <version>1.14.0</version>
            </plugin>
          </plugins>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>lemuri.App</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
